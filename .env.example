# Open Brain — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.

# Database host port (dev: 5433, prod: 5432)
DB_PORT=5432

# Database password (generate: openssl rand -hex 32)
DB_PASSWORD=

# OpenRouter API key (from https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Access key for Brain API (generate: openssl rand -hex 32)
BRAIN_ACCESS_KEY=

# Optional: Override embedding model (default: openai/text-embedding-3-small)
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: Override extraction model (default: openai/gpt-4o-mini)
# EXTRACTION_MODEL=openai/gpt-4o-mini

# Optional: Portainer settings for `make deploy`
# PORTAINER_URL=http://your-portainer-host:9000
# PORTAINER_API_KEY=
# PORTAINER_STACK_ID=
# PORTAINER_ENDPOINT_ID=
